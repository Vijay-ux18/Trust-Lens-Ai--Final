# ==============================================================================
# TrustLens AI - Environment Configurations Example
# Rename this file to '.env' and modify settings for local execution.
# ==============================================================================

# Application Environment State: 'development' or 'production'
APP_ENV=development

# System Logging Severity: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# Allow dynamic rule-based analysis simulation if ML joblib files are missing
ALLOW_SIMULATION_MODE=True

# Network configurations for Streamlit Server
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Paths overrides for serialized model artifacts
MODEL_ASSET_PATH=malware_model.joblib
PREPROCESSOR_ASSET_PATH=preprocessor.joblib

# Optional hash-only threat-intelligence lookup. Never uploads file bytes.
# VIRUSTOTAL_API_KEY=
